# Production settings for compose.yaml. On the VPS:
#   cp .env.production.example .env && chmod 600 .env && nano .env
# (Local development doesn't use this file; it uses server/.env.)

# --- Domains (each needs a DNS A record pointing to the VPS) ---
CSC_DOMAIN=csc.decodificat.ro
WEBAPP_DOMAIN=cscweb.decodificat.ro

# --- Shared OAuth client secret (server and web app) ---
# Generate with:  openssl rand -base64 32
OAUTH_CLIENT_SECRET=

# --- Email (signing codes and sign-up confirmation links) ---
# Gmail: smtp.gmail.com, 587, starttls, your address and an App Password.
# Leave SMTP_HOST empty for console mode: codes and links appear in `docker compose logs csc-server`.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="CSC Demo <you@gmail.com>"

# --- Built-in demo account "alice" ---
# Signing codes for alice's qualified credential go to this inbox.
DEMO_USER_EMAIL=
# alice's password. The repository default (alice-password) is public, so pick your own.
DEMO_USER_PASSWORD=
# Signing PINs of alice's two credentials
DEMO_PIN_QES=123456
DEMO_PIN_ADV=1234

# Prefill the web app's login form with "user:password". Empty = prefill nothing (recommended:
# visitors create their own account). Set it to alice:<DEMO_USER_PASSWORD> to make alice public;
# visitors then make the server email DEMO_USER_EMAIL.
WEBAPP_DEMO_LOGIN=

# --- Limits (defaults shown) ---
# CSC_MAX_USERS=500
# CSC_MAX_CREDENTIALS_PER_USER=5
# CSC_SIGNUPS_PER_IP_PER_HOUR=5

# --- Docker network shared with the decodificat Caddy ---
# PROXY_NETWORK=decodificat_default

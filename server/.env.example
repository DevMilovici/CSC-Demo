# Copy to server/.env and fill in. Never commit the real .env.

# Where the signing codes go: the demo user's real inbox
DEMO_USER_EMAIL=you@example.com
# Optional: change the demo login / PINs
# DEMO_USER_PASSWORD=alice-password
# DEMO_PIN_QES=123456
# DEMO_PIN_ADV=1234

# --- SMTP (leave SMTP_HOST empty to print codes to the console instead) ---
# Gmail: needs 2-Step Verification and an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=CSC Demo <you@gmail.com>

# Any other provider works the same way: use its SMTP host, port and credentials.
# Port 465 → SMTP_SECURITY=ssl ; port 587 → starttls ; local test servers (e.g. Mailpit on 1025) → none

# Optional tuning
# CSC_PORT=8080
# CSC_SAD_TTL=300
# CSC_RESEND_COOLDOWN=30

# --- Accounts and OAuth 2.0 (defaults work on localhost; set these when deploying) ---
# Public base URL of this server: used in confirmation emails and in info's "oauth2" field
# CSC_PUBLIC_URL=https://csc.example.org
# The web app's OAuth client. Use a long random secret and give the same one to the web app (OAUTH_CLIENT_SECRET)
# CSC_OAUTH_CLIENT_ID=csc-signer
# CSC_OAUTH_CLIENT_SECRET=change-me
# Comma-separated, must match the web app's WEBAPP_PUBLIC_URL + /oauth/callback exactly
# CSC_OAUTH_REDIRECT_URIS=https://signer.example.org/oauth/callback
# Abuse limits
# CSC_MAX_USERS=500
# CSC_MAX_CREDENTIALS_PER_USER=5
# CSC_SIGNUPS_PER_IP_PER_HOUR=5
# Where keys and certificates are written (point at a persistent volume)
# CSC_DATA_DIR=/var/lib/csc-demo
# Listen on all interfaces (behind a reverse proxy)
# CSC_HOST=0.0.0.0
